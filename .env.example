# =============================================================================
# FISCAL INTELLIGENCE PLATFORM - AMBIENTE DE DESENVOLVIMENTO LOCAL
# Exemplo de configuração sem credenciais reais ou dados sensíveis.
# =============================================================================

NODE_ENV=development
PORT=3333
HOST=127.0.0.1
APP_NAME=FiscalIntelligencePlatform

# Database Configuration
# Local SQLite default for zero-friction self-contained run; PostgreSQL supported
DATABASE_TYPE=sqlite
DATABASE_URL=file:./data/fiscal_platform.db
# Para PostgreSQL: postgresql://postgres:postgres@localhost:5432/fiscal_intelligence

# Storage Configuration
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/documents
MAX_FILE_SIZE_BYTES=10485760 # 10 MB

# Security and Sessions
SESSION_SECRET=desenvolvimento_chave_secreta_minimo_32_caracteres_ficticia
CORS_ORIGIN=http://localhost:5173

# Logging and Auditing
LOG_LEVEL=info
EVIDENCE_HASH_ALGORITHM=sha256

# Mock Official Connectors
SEFAZ_MOCK_ENABLED=true
RECEITA_FEDERAL_MOCK_ENABLED=true
ECAC_MOCK_ENABLED=true
FGTS_MOCK_ENABLED=true
